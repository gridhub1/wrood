rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /posts/{uid}/{f} { allow read: if request.auth != null;
      allow write: if request.auth.uid == uid && request.resource.size < 10*1024*1024; }
    match /avatars/{uid} { allow read: if request.auth != null;
      allow write: if request.auth.uid == uid && request.resource.size < 3*1024*1024; }
    match /media/{f} { allow read: if request.auth != null; allow write: if false; } // ارفع وسائل المحتوى من الـ Console
  }
}
