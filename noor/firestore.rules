rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed(){ return request.auth != null; }
    function me(){ return request.auth.uid; }
    function admin(){ return signed() && exists(/databases/$(db)/documents/admins/$(me())); }

    match /admins/{uid} { allow read: if me() == uid; allow write: if false; }

    match /users/{uid} {
      allow read: if signed();
      allow create: if me() == uid && request.resource.data.points == 0
                    && request.resource.data.verified == false;
      // النقاط والتوثيق لا يتغيران من المتصفح إلا بواسطة الأدمن أو Cloud Functions
      allow update: if admin() || (me() == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','bio','photo','lastSeen']));
      match /friends/{f} { allow read, write: if me() == uid; }
      match /notifs/{n} { allow read: if me() == uid || admin();
        allow create: if signed() && request.resource.data.from == me() || admin();
        allow delete: if me() == uid || admin(); }
      match /done/{q} { allow read: if me() == uid; }
      match /hints/{q} { allow read: if me() == uid; }
    }

    match /posts/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.u == me();
      allow update: if admin() || resource.data.u == me() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']);
      allow delete: if admin() || resource.data.u == me();
    }

    match /chats/{cid} {
      allow read, write: if signed() && (me() in cid.split('_') || admin());
      match /msgs/{m} {
        allow read: if signed() && (me() in cid.split('_') || admin());
        allow create: if signed() && me() in cid.split('_') && request.resource.data.from == me();
        allow update, delete: if admin();
      }
    }

    match /calls/{id} { allow read, write: if signed();
      match /{sub}/{c} { allow read, write: if signed(); } }

    match /content/{id}   { allow read: if signed(); allow write: if admin(); }
    match /questions/{id} { allow read: if signed(); allow write: if admin(); }
    match /answers/{id}   { allow read, write: if admin(); }
    match /ads/{id}       { allow read: if signed(); allow write: if admin(); }
  }
}
